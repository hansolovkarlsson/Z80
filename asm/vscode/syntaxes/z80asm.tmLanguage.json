{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "z80asm",
  "scopeName": "source.z80asm",
  "comment": "Generated by asm/vscode/build_grammar.py; edit that, not this file.",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#string"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#mnemonic"
    },
    {
      "include": "#register"
    },
    {
      "include": "#condition"
    },
    {
      "include": "#word-operator"
    },
    {
      "include": "#macro-arg"
    },
    {
      "include": "#number"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "match": ";.*$",
      "name": "comment.line.semicolon.z80asm"
    },
    "string": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.z80asm"
        },
        {
          "comment": "A ' after a letter, digit or _ does not open a string, exactly as the assembler reads AF'.",
          "begin": "(?<![A-Za-z0-9_])'",
          "end": "'|$",
          "name": "string.quoted.single.z80asm"
        }
      ]
    },
    "definition": {
      "patterns": [
        {
          "comment": "name MACRO params",
          "match": "^\\s*([A-Za-z_.][A-Za-z0-9_.]*):?\\s+((?i:macro))\\b",
          "captures": {
            "1": {
              "name": "entity.name.function.macro.z80asm"
            },
            "2": {
              "name": "storage.type.directive.z80asm"
            }
          }
        },
        {
          "comment": "name EQU expr",
          "match": "^\\s*([A-Za-z_.][A-Za-z0-9_.]*):?\\s+((?i:equ))\\b",
          "captures": {
            "1": {
              "name": "variable.other.constant.z80asm"
            },
            "2": {
              "name": "storage.type.directive.z80asm"
            }
          }
        },
        {
          "comment": "name: at the start of a line",
          "match": "^\\s*([A-Za-z_.][A-Za-z0-9_.]*)(:)",
          "captures": {
            "1": {
              "name": "entity.name.function.label.z80asm"
            },
            "2": {
              "name": "punctuation.separator.label.z80asm"
            }
          }
        },
        {
          "comment": "a colon-less label: a column-0 word that is not a keyword",
          "match": "^(?!(?i:(?:INCLUDE|ENDIF|ERROR|MACRO|LOCAL|CALL|CPDR|CPIR|DJNZ|HALT|INDR|INIR|LDDR|LDIR|OTDR|OTIR|OUTD|OUTI|PUSH|RETI|RETN|RLCA|RRCA|DEFB|DEFW|DEFS|ASEG|CSEG|DSEG|ELSE|REPT|ENDM|ADC|ADD|AND|BIT|CCF|CPD|CPI|CPL|DAA|DEC|EXX|INC|IND|INI|LDD|LDI|NEG|NOP|OUT|POP|RES|RET|RLA|RLC|RLD|RRA|RRC|RRD|RST|SBC|SCF|SET|SL1|SLA|SLL|SRA|SRL|SUB|XOR|ORG|EQU|END|CP|DI|EI|EX|IM|IN|JP|JR|LD|OR|RL|RR|DB|DW|DS|IF))\\b)([A-Za-z_][A-Za-z0-9_]*)(?=\\s|;|$)",
          "captures": {
            "1": {
              "name": "entity.name.function.label.z80asm"
            }
          }
        }
      ]
    },
    "directive": {
      "match": "(?i)\\b(?:INCLUDE|ENDIF|ERROR|MACRO|LOCAL|DEFB|DEFW|DEFS|ASEG|CSEG|DSEG|ELSE|REPT|ENDM|ORG|EQU|END|DB|DW|DS|IF)\\b",
      "name": "storage.type.directive.z80asm"
    },
    "mnemonic": {
      "match": "(?i)\\b(?:CALL|CPDR|CPIR|DJNZ|HALT|INDR|INIR|LDDR|LDIR|OTDR|OTIR|OUTD|OUTI|PUSH|RETI|RETN|RLCA|RRCA|ADC|ADD|AND|BIT|CCF|CPD|CPI|CPL|DAA|DEC|EXX|INC|IND|INI|LDD|LDI|NEG|NOP|OUT|POP|RES|RET|RLA|RLC|RLD|RRA|RRC|RRD|RST|SBC|SCF|SET|SL1|SLA|SLL|SRA|SRL|SUB|XOR|CP|DI|EI|EX|IM|IN|JP|JR|LD|OR|RL|RR)\\b",
      "name": "keyword.other.mnemonic.z80asm"
    },
    "register": {
      "match": "(?i)\\b(?:AF'|IXH|IXL|IYH|IYL|AF|BC|DE|HL|SP|IX|IY|A|B|C|D|E|H|L|I|R)(?![A-Za-z0-9_.])",
      "name": "variable.language.register.z80asm"
    },
    "condition": {
      "match": "(?i)\\b(?:NZ|NC|PO|PE|Z|P|M)\\b",
      "name": "keyword.other.condition.z80asm"
    },
    "word-operator": {
      "match": "(?i)\\b(?:high|low|eq|ne|lt|le|gt|ge)\\b",
      "name": "keyword.operator.word.z80asm"
    },
    "macro-arg": {
      "match": "&[A-Za-z_][A-Za-z0-9_]*",
      "name": "variable.parameter.z80asm"
    },
    "number": {
      "patterns": [
        {
          "match": "(?i)\\b0x[0-9a-f]+\\b",
          "name": "constant.numeric.hex.z80asm"
        },
        {
          "match": "(?i)\\$[0-9a-f]+\\b",
          "name": "constant.numeric.hex.z80asm"
        },
        {
          "match": "(?i)\\b[0-9][0-9a-f]*h\\b",
          "name": "constant.numeric.hex.z80asm"
        },
        {
          "match": "(?i)\\b[01]+b\\b",
          "name": "constant.numeric.binary.z80asm"
        },
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.decimal.z80asm"
        },
        {
          "comment": "$ alone is the current address",
          "match": "\\$",
          "name": "variable.language.location-counter.z80asm"
        }
      ]
    },
    "operator": {
      "match": "<<|>>|<=|>=|<>|[-+*/%&|^~=<>]",
      "name": "keyword.operator.z80asm"
    }
  }
}
