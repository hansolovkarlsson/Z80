40 PRINT CUR(R,0);CHR$(151);
50 NEXT R
60 FOR K=4 TO 75
70 SETDOT 3,K
80 SETDOT 62,K
90 NEXT K
100 FOR R=3 TO 62
110 SETDOT R,4
120 SETDOT R,75
130 NEXT R
