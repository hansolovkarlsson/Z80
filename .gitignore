bin/
z80core/*.o
abcbus/*.o
cpm/emu/src/*.o
asm/src/*.o
disasm/src/*.o
cpm/gtk/src/*.o
abc80/emu/src/*.o
abc80/gtk/src/*.o
abc802/emu/src/*.o
abc802/gtk/src/*.o

# Header-dependency files generated by the Makefile's -MMD -MP (see the
# comment on CFLAGS there). Build artifacts, same as the .o files above.
*.d
.claude/
cpm_disk/
!/cpm/cpm_disk/

# Real ABC-bus floppy images. Third-party disk dumps with no license
# statement anywhere, unlike the ROM images (which carry an explicit
# provenance and checksum table) - so they stay out of the repo while the
# directory itself, and the README documenting what belongs in it, do not.
# See abc802/resources/disks/README.md.
abc80/resources/disks/*
!abc80/resources/disks/README.md
abc802/resources/disks/*
!abc802/resources/disks/README.md
